.vscode/
.idea/
*.swp
*.swo
*~

# ============================================
# PYTHON - 02-api-model (API)
# ============================================
02-api-model/venv/
02-api-model/__pycache__/
02-api-model/api/__pycache__/
02-api-model/api/routers/__pycache__/
02-api-model/solvers/__pycache__/
