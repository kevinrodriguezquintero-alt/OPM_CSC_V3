02-api-model.*.so
02-api-model/.env
02-api-model/.env.local

# NOTA: redaccion/maestros/ se SUBE al repositorio
# (son los archivos maestros consolidados)

# ============================================
# BACKUPS AUTO-GENERADOS
# ============================================
redaccion/backups/backup_*/

# ============================================
# RESULTADOS TEMPORALES (no consolidados)
# ============================================
# NOTA: Los archivos en resultados/ son TEMPORALES y se regeneran en cada ejecución.
# Los archivos consolidados en maestros/ SÍ se versionan.
redaccion/resultados/*.json
!redaccion/resultados/.gitkeep
redaccion/resultados/escenarios/*.json
!redaccion/resultados/escenarios/.gitkeep

# ============================================
# LOGS Y ARCHIVOS DE GESTION LOCAL
# ============================================
redaccion/tools/update_log.txt
export_log.txt
PENDIENTES.md
*.log

# ============================================
# DOCS / OUTPUTS GENERADOS
# ============================================
docs/*.json
docs/*.csv
docs/*.xlsx

# ============================================
# ARCHIVOS COMPRIMIDOS
# ============================================
*.zip
*.tar.gz
*.rar

# ============================================
# EVITAR DUPLICACION ACCIDENTAL
# ============================================
/V3/

# ============================================
# NODE MODULES (si se agrega frontend con npm)
